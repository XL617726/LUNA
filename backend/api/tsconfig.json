{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "declaration": true,
    "paths": {
      "@luna/shared-types": ["../../packages/shared-types/src"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
