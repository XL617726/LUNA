{
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "LUNA · 星光歌姬",
        "navigationStyle": "custom",
        "disableScroll": true
      }
    },
    {
      "path": "pages/music/music",
      "style": {
        "navigationBarTitleText": "音乐中心"
      }
    },
    {
      "path": "pages/character/character",
      "style": {
        "navigationBarTitleText": "角色中心"
      }
    },
    {
      "path": "pages/memory/memory",
      "style": {
        "navigationBarTitleText": "回忆空间"
      }
    },
    {
      "path": "pages/setting/setting",
      "style": {
        "navigationBarTitleText": "设置"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarBackgroundColor": "#1a1a2e",
    "backgroundColor": "#0f0f23",
    "backgroundTextStyle": "light"
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^pixel-(.*)": "@/components/PixelCharacter/$1.vue",
      "^music-(.*)": "@/components/MusicPlayer/$1.vue"
    }
  }
}
