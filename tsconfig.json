{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@luna/character-engine": ["packages/character-engine/src"],
      "@luna/animation-engine": ["packages/animation-engine/src"],
      "@luna/audio-engine": ["packages/audio-engine/src"],
      "@luna/ai-engine": ["packages/ai-engine/src"],
      "@luna/story-engine": ["packages/story-engine/src"],
      "@luna/ui-system": ["packages/ui-system/src"],
      "@luna/shared-types": ["packages/shared-types/src"]
    }
  },
  "exclude": ["node_modules", "dist", "unpackage"]
}
