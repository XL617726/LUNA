# LUNA v1.0 — Environment Configuration
# Copy to .env and fill in your values

# ===== CloudBase =====
TCB_ENV_ID=luna-prod
TCB_SECRET_ID=your_secret_id
TCB_SECRET_KEY=your_secret_key

# ===== MongoDB =====
MONGO_URI=mongodb://localhost:27017/luna

# ===== COS Storage =====
COS_SECRET_ID=your_secret_id
COS_SECRET_KEY=your_secret_key
COS_BUCKET=luna-assets-1234567890
COS_REGION=ap-guangzhou
COS_BASE_URL=https://luna-assets.cos.ap-guangzhou.myqcloud.com

# ===== Auth =====
JWT_SECRET=change-this-in-production

# ===== AI (optional) =====
AI_API_KEY=your_api_key
AI_MODEL=claude-sonnet-5

# ===== App =====
NODE_ENV=development
PORT=3001
